# ==============================================================================
# Voxify Production Environment Variables Configuration Template
# Sao chép file này sang `.env.production` trên server và điền các giá trị bảo mật
# ==============================================================================

# ── 1. Cấu hình Chung & Tên miền ────────────────────────────────────────────
APP_NAME=Voxify
ENVIRONMENT=production
DEBUG=false
DOMAIN=voxify.example.com
ACME_EMAIL=admin@example.com

# URL gốc frontend & backend
BACKEND_URL=https://voxify.example.com
ALLOWED_ORIGINS=https://voxify.example.com,http://localhost:5173

# ── 2. Bảo mật & Xác thực JWT ────────────────────────────────────────────────
# Tạo chuỗi bí mật an toàn bằng lệnh: openssl rand -hex 32
SECRET_KEY=change_this_to_a_super_secret_production_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── 3. Cơ sở dữ liệu PostgreSQL 16 ──────────────────────────────────────────
POSTGRES_DB=voxify_prod
POSTGRES_USER=voxify_user
POSTGRES_PASSWORD=replace_with_strong_database_password_here
DATABASE_URL=postgresql+asyncpg://voxify_user:replace_with_strong_database_password_here@db:5432/voxify_prod

# ── 4. Redis 7 (Cache, ARQ Worker Queue, Rate Limit) ────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 5. Lưu trữ Cloudflare R2 / AWS S3 ────────────────────────────────────────
# storage_backend có thể là: "r2" | "s3" | "local"
STORAGE_BACKEND=r2
S3_ENDPOINT_URL=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_BUCKET_NAME=voxify-audio-prod
S3_REGION_NAME=auto
# URL CDN công khai (nếu có gắn custom domain trên Cloudflare R2 bucket)
S3_PUBLIC_CDN_URL=https://media.voxify.example.com
S3_PRESIGNED_EXPIRY_SECONDS=3600

# Đường dẫn storage cục bộ (dùng khi STORAGE_BACKEND=local)
STORAGE_PATH=./storage/audio

# ── 6. Nhà cung cấp TTS (Text To Speech) & Voice Clone ──────────────────────
TTS_PROVIDER=edge
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
ELEVENLABS_API_KEY=

# ── 7. Cổng thanh toán & Nạp Credit ─────────────────────────────────────────
VIETQR_BANK_ID=970422
VIETQR_ACCOUNT_NO=123456789
VIETQR_ACCOUNT_NAME=CONG TY VOXIFY
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ── 8. Giám sát & Quan sát (Observability) ───────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── 9. Sao lưu & Dọn dẹp (Backup & Retention) ───────────────────────────────
BACKUP_RETENTION_DAYS=7
