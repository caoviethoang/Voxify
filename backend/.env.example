APP_NAME=Voxify
APP_DESCRIPTION=Nền tảng chuyển đổi văn bản thành giọng nói tiếng Việt chất lượng cao

HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=your-secret-key-here

DATABASE_URL=sqlite+aiosqlite:///./storage/db.sqlite
REDIS_URL=redis://localhost:6379/0

STORAGE_PATH=./storage/audio
STORAGE_BACKEND=local

TTS_PROVIDER=edge
DEFAULT_VOICE=vi-VN-HoaiMyNeural

MAX_CHARS=20000
CHUNK_SIZE=2500

# Google OAuth
GOOGLE_CLIENT_ID=

# Email SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@voxify.vn
REQUIRE_EMAIL_VERIFICATION=false
